# Project-specific ignores only - OS/editor/generic-JVM-tooling churn (.DS_Store, .gradle/,
# .idea/, *.class, .cxx/, etc.) lives in the root .gitignore instead (applies automatically -
# this and the root file are both part of the same monorepo).

/local.properties
/build
/captures
app/build/
app/release/
*.apk
*.ap_
*.dex
bin/
gen/
out/
