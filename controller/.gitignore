# Project-specific ignores only - OS/editor/generic-node-tooling churn (.DS_Store, node_modules/,
# .idea/, *.log, etc.) lives in the root .gitignore instead (applies automatically - this and the
# root file are both part of the same monorepo).

installer-src/bin
frontend/dist
frontend/package.json.md5
/run-controller.log

# Runtime state: SQLite DB, single-instance lock, downloaded clip archive.
# Not part of the shipped source — recreated on first run (see internal/appdirs).
/data/
/archive/
